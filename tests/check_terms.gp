\\ tests/check_terms.gp -- the 45 terms below 10^28 against Howe's definition, in PARI/GP.
\\ Usage:  gp -q tests/check_terms.gp     (written 7 Oct 2026; NOT yet run here: PARI/GP was not installed)
isCN2(n) = { my(P = factor(n)[,1]); if (n % 2 == 0 || #P < 2 || !issquarefree(n), return(0));
  for (i = 1, #P, my(r = n % (P[i]^2 - 1)); if (r != 1 && r != P[i], return(0))); 1 };
isrigid(n) = { my(P = factor(n)[,1]); for (i = 1, #P, if (n % (P[i]^2 - 1) != 1, return(0))); 1 };
L = [443372888629441, 39671149333495681, 842526563598720001,\
  2380296518909971201, 3188618003602886401, 4208895375600667752001,\
  1159954316194989017102401, 2088144166339753513992001, 2196407820059694924883201,\
  3339611018825185787482801, 4105879060352839139462401, 5002862939121639632040001,\
  7865064643837556041286401, 9400084864021826054720641, 12071465216556111317952001,\
  31280524488319495535546401, 32492501043239735947612801, 36991212507320386599648001,\
  44774022865681509785985601, 50473184681492173584023041, 54475112449147532388966721,\
  76587257660615840312697601, 111356194710608262218643841, 373851853012084355680131361,\
  419746116449969951645203201, 480650413824292471675755841, 507710311713618241797676801,\
  571197082724681188312817281, 598764213578029575774297601, 667882655094744395121816001,\
  768927403921604814222336001, 922904786964947393227420801, 946295515632681859275671041,\
  1941211286859256920630460801, 2119047331560739293908113921, 2142752298785201165308646401,\
  2325041445996414342573536161, 3213322593860118229475166721, 4635427415991948819511107841,\
  5466953848346666426169619201, 6037031106243073961934109201, 6473975735726053723736568001,\
  7006270310872326698183179201, 8601689148505906566116203201, 9799274291299994931676646401];
ok = (#L == 45) && (L[#L] < 10^28) && (vecsort(L) == L);
for (i = 1, #L, if (!isCN2(L[i]), ok = 0; print("FAIL a(", i, ") = ", L[i])));
print(#L, " terms; all satisfy the definition: ", ok, "; rigid: ", sum(i = 1, #L, isrigid(L[i])));
quit;
